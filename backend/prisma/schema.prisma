// =======================================================
// PRISMA SCHEMA - WORKFLOW REPOSITORY MANAGEMENT SYSTEM
// =======================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------
// ENUMS
// -------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  SALES
  HEAD_SOLUTION_ARCHITECT
  SOLUTION_ARCHITECT
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
  OVERDUE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVISED
}

enum DocumentStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUPERSEDED
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  SUBMIT
  APPROVE
  REJECT
  UPLOAD_DOCUMENT
  CHANGE_STATUS
  COMMENT
}

// -------------------------------------------------------
// 1. USER & AUTHENTICATION
// -------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  username     String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  phoneNumber  String?   @map("phone_number")
  avatarUrl    String?   @map("avatar_url")
  role         UserRole  @default(SOLUTION_ARCHITECT)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  createdProjects    Project[]          @relation("ProjectCreatedBy")
  salesProjects      Project[]          @relation("ProjectSalesPIC")
  headSaProjects     Project[]          @relation("ProjectHeadSAPIC")
  assignedMilestones ProjectMilestone[] @relation("MilestonePIC")
  approvalsGiven     Approval[]         @relation("ApproverUser")
  comments           Comment[]          @relation("UserComments")
  activityLogs       ActivityLog[]      @relation("UserActivityLogs")
  uploadedDocuments  DocumentVersion[]  @relation("DocumentUploadedBy")
  refreshTokens      RefreshToken[]

  // Assignment history relations
  assignmentsGiven   AssignmentHistory[] @relation("AssignmentAssignedBy")
  assignedAsPrevPIC  AssignmentHistory[] @relation("AssignmentPrevPIC")
  assignedAsNewPIC   AssignmentHistory[] @relation("AssignmentNewPIC")

  @@index([role])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  revoked   Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// -------------------------------------------------------
// 2. WORKFLOW TEMPLATES & SCENARIOS
// -------------------------------------------------------

model WorkflowTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique // e.g. "WF-ERP-IMPL", "WF-CLOUD-MIGRATION"
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  scenarios Scenario[]
  stages    WorkflowStage[]

  @@map("workflow_templates")
}

model Scenario {
  id                 String   @id @default(uuid())
  workflowTemplateId String   @map("workflow_template_id")
  name               String   // e.g. "Fast Track / Low Risk", "Complex Enterprise"
  code               String   @unique
  description        String?
  slaWorkingDays     Int      @default(30) @map("sla_working_days")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  workflowTemplate WorkflowTemplate @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)
  stages           WorkflowStage[]
  projects         Project[]

  @@index([workflowTemplateId])
  @@map("scenarios")
}

model WorkflowStage {
  id                  String   @id @default(uuid())
  workflowTemplateId  String   @map("workflow_template_id")
  scenarioId          String?  @map("scenario_id")
  name                String   // e.g. "MoM", "Handover", "Assessment", "Proposal", "BOQ"
  code                String?  // e.g. "MOM", "HANDOVER", "ASSESSMENT", "PROPOSAL", "BOQ"
  orderIndex          Int      @map("order_index")
  defaultDurationDays Int      @default(3) @map("default_duration_days") // Working days
  requiresApproval    Boolean  @default(false) @map("requires_approval")
  approverRole        UserRole @default(HEAD_SOLUTION_ARCHITECT) @map("approver_role")
  description         String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  workflowTemplate WorkflowTemplate   @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)
  scenario         Scenario?          @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  milestones       ProjectMilestone[]

  @@unique([workflowTemplateId, orderIndex])
  @@index([scenarioId])
  @@map("workflow_stages")
}

// -------------------------------------------------------
// 3. PROJECT & MILESTONES
// -------------------------------------------------------

model Project {
  id             String        @id @default(uuid())
  projectCode    String        @unique @map("project_code") // e.g. "PRJ-2026-001"
  name           String
  clientName     String        @map("client_name")
  description    String?
  scenarioId     String        @map("scenario_id")
  createdById    String        @map("created_by_id")
  salesId        String        @map("sales_id")
  headSaId       String?       @map("head_sa_id")
  status         ProjectStatus @default(DRAFT)
  startDate      DateTime      @map("start_date")
  targetEndDate  DateTime      @map("target_end_date")
  actualEndDate  DateTime?     @map("actual_end_date")
  postponeReason String?       @map("postpone_reason")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  // Relations
  scenario     Scenario           @relation(fields: [scenarioId], references: [id], onDelete: Restrict)
  createdBy    User               @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  salesPIC     User               @relation("ProjectSalesPIC", fields: [salesId], references: [id], onDelete: Restrict)
  headSaPIC    User?              @relation("ProjectHeadSAPIC", fields: [headSaId], references: [id], onDelete: SetNull)
  milestones          ProjectMilestone[]
  documents           Document[]
  comments            Comment[]
  activityLogs        ActivityLog[]
  assignmentHistories AssignmentHistory[]

  @@index([scenarioId])
  @@index([createdById])
  @@index([salesId])
  @@index([headSaId])
  @@index([status])
  @@map("projects")
}

model ProjectMilestone {
  id              String          @id @default(uuid())
  projectId       String          @map("project_id")
  workflowStageId String?         @map("workflow_stage_id")
  name            String
  orderIndex      Int             @map("order_index")
  picId           String          @map("pic_id") // PIC (Solution Architect)
  status          MilestoneStatus @default(NOT_STARTED)
  startDate       DateTime?       @map("start_date")
  deadline        DateTime        @map("deadline") // Dihitung dari working days
  actualEndDate   DateTime?       @map("actual_end_date")
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  // Relations
  project             Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workflowStage       WorkflowStage?      @relation(fields: [workflowStageId], references: [id], onDelete: SetNull)
  pic                 User                @relation("MilestonePIC", fields: [picId], references: [id], onDelete: Restrict)
  approvals           Approval[]
  documents           Document[]
  comments            Comment[]
  activityLogs        ActivityLog[]
  assignmentHistories AssignmentHistory[]

  @@unique([projectId, orderIndex])
  @@index([projectId])
  @@index([picId])
  @@index([status])
  @@index([deadline])
  @@map("project_milestones")
}

// -------------------------------------------------------
// 4. DOCUMENT MANAGEMENT & VERSIONING
// -------------------------------------------------------

model Document {
  id          String         @id @default(uuid())
  projectId   String         @map("project_id")
  milestoneId String?        @map("milestone_id")
  title       String
  category    String?        // e.g. "Architecture Diagram", "Proposal", "Sizing Sheet"
  status      DocumentStatus @default(DRAFT)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  // Relations
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  versions  DocumentVersion[]
  comments  Comment[]

  @@index([projectId])
  @@index([milestoneId])
  @@map("documents")
}

model DocumentVersion {
  id            String         @id @default(uuid())
  documentId    String         @map("document_id")
  versionNumber Int            @default(1) @map("version_number") // 1, 2, 3...
  fileName      String         @map("file_name")
  fileUrl       String         @map("file_url")
  fileSize      Int            @map("file_size") // in bytes
  mimeType      String         @map("mime_type")
  changelog     String?
  status        DocumentStatus @default(SUBMITTED)
  uploadedById  String         @map("uploaded_by_id")
  isLatest      Boolean        @default(true) @map("is_latest")
  createdAt     DateTime       @default(now()) @map("created_at")

  // Relations
  document   Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User       @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  approvals  Approval[]

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@index([uploadedById])
  @@map("document_versions")
}

// -------------------------------------------------------
// 5. APPROVAL & COLLABORATION
// -------------------------------------------------------

model Approval {
  id                String         @id @default(uuid())
  milestoneId       String?        @map("milestone_id")
  documentVersionId String?        @map("document_version_id")
  approverId        String         @map("approver_id")
  status            ApprovalStatus @default(PENDING)
  actionRole        UserRole       @map("action_role") // Role saat mereview (HEAD_SOLUTION_ARCHITECT, SUPER_ADMIN, SALES)
  feedback          String?
  approvedAt        DateTime?      @map("approved_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  // Relations
  milestone       ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion?  @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  approver        User              @relation("ApproverUser", fields: [approverId], references: [id], onDelete: Restrict)

  @@index([milestoneId])
  @@index([documentVersionId])
  @@index([approverId])
  @@index([status])
  @@map("approvals")
}

model Comment {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  milestoneId String?  @map("milestone_id")
  documentId  String?  @map("document_id")
  authorId    String   @map("author_id")
  content     String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  document  Document?         @relation(fields: [documentId], references: [id], onDelete: SetNull)
  author    User              @relation("UserComments", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([milestoneId])
  @@index([documentId])
  @@index([authorId])
  @@map("comments")
}

// -------------------------------------------------------
// 6. ACTIVITY LOG & AUDIT TRAIL
// -------------------------------------------------------

model ActivityLog {
  id          String         @id @default(uuid())
  userId      String?        @map("user_id")
  projectId   String?        @map("project_id")
  milestoneId String?        @map("milestone_id")
  action      ActivityAction
  entityType  String         @map("entity_type") // e.g. "PROJECT", "MILESTONE", "DOCUMENT", "APPROVAL"
  entityId    String         @map("entity_id")
  details     String?
  metadata    Json?          // Snapshot data sebelum / sesudah perubahan
  ipAddress   String?        @map("ip_address")
  userAgent   String?        @map("user_agent")
  createdAt   DateTime       @default(now()) @map("created_at")

  // Relations
  user      User?             @relation("UserActivityLogs", fields: [userId], references: [id], onDelete: SetNull)
  project   Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([milestoneId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

// -------------------------------------------------------
// 7. HOLIDAY & WORKING DAY CALCULATION
// -------------------------------------------------------

model Holiday {
  id          String   @id @default(uuid())
  name        String   // e.g. "Tahun Baru Masehi", "Hari Raya Idul Fitri"
  date        DateTime @db.Date // Tanggal libur (YYYY-MM-DD)
  isRecurring Boolean  @default(false) @map("is_recurring") // Apakah berulang setiap tahun
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([date])
  @@index([date])
  @@map("holidays")
}

// -------------------------------------------------------
// 8. ASSIGNMENT AUDIT & HISTORY
// -------------------------------------------------------

model AssignmentHistory {
  id               String   @id @default(uuid())
  projectId        String   @map("project_id")
  milestoneId      String?  @map("milestone_id")
  previousPicId    String?  @map("previous_pic_id")
  newPicId         String   @map("new_pic_id")
  assignedById     String   @map("assigned_by_id") // Head SA or Admin
  reason           String?
  assignedToFuture Boolean  @default(true) @map("assigned_to_future")
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone   ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  previousPic User?             @relation("AssignmentPrevPIC", fields: [previousPicId], references: [id], onDelete: SetNull)
  newPic      User              @relation("AssignmentNewPIC", fields: [newPicId], references: [id], onDelete: Restrict)
  assignedBy  User              @relation("AssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([milestoneId])
  @@index([newPicId])
  @@index([assignedById])
  @@map("assignment_histories")
}
